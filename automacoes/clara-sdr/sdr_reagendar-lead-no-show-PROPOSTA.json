    {
      "parameters": {
        "jsCode": "// Seleciona 2 slots (1 manhã + 1 tarde). Fallback A: só um turno -> 1º e último desse turno.\nconst items = $input.all().map(i => i.json);\n\n// defensivo: acha o item que traz os horários do closer (Edit Fields da consulta_agenda)\nconst src = items.find(j => Array.isArray(j.horarios) && j.horarios.length)\n         || items.find(j => Array.isArray(j.horarios))\n         || {};\nconst fallback = items.some(j => j && j.fallback === true);\n\n// os horários vêm formatados: \"Quinta (02/07) às 10:00\" e abrangem vários dias úteis\nconst horarios = Array.isArray(src.horarios) ? src.horarios : [];\n\n// dia alvo (dia seguinte) vindo do nó anterior: \"YYYY-MM-DD\"\nconst alvo = $('Calcular dia seguinte').first().json.data_alvo;\nconst [, alvoMM, alvoDD] = alvo.split('-');\n\n// parse \"DiaSemana (DD/MM) às HH:MM\" e filtra só o dia alvo\nconst re = /\\((\\d{2})\\/(\\d{2})\\)\\s*às\\s*(\\d{2}):(\\d{2})/;\nconst doDia = [];\nfor (const h of horarios) {\n  const m = String(h).match(re);\n  if (!m) continue;\n  const [, dd, mm, HH, MM] = m;\n  if (dd === alvoDD && mm === alvoMM) {\n    doDia.push({ txt: h, hour: parseInt(HH, 10), min: parseInt(MM, 10) });\n  }\n}\ndoDia.sort((a, b) => a.hour - b.hour || a.min - b.min);\n\nconst manha = doDia.filter(p => p.hour < 12);\nconst tarde = doDia.filter(p => p.hour >= 12);\n\nlet slot1, slot2;\nif (!fallback && manha.length >= 1 && tarde.length >= 1) {\n  slot1 = manha[0].txt; slot2 = tarde[0].txt;                 // regra principal: 1 manhã + 1 tarde\n} else if (!fallback && manha.length >= 2) {\n  slot1 = manha[0].txt; slot2 = manha[manha.length - 1].txt;  // fallback A: só manhã\n} else if (!fallback && tarde.length >= 2) {\n  slot1 = tarde[0].txt; slot2 = tarde[tarde.length - 1].txt;  // fallback A: só tarde\n}\n\nconst ok = !!(slot1 && slot2);\nconst g = $('Get a row').first().json;\n\nreturn [{ json: {\n  ok,\n  slot1_txt: slot1 || null,   // já vem \"Quinta (02/07) às 10:00\"\n  slot2_txt: slot2 || null,\n  closer_nome: src.nome || null,\n  name_first: String(g.name || '').split(' ')[0],\n  whatsapp: g.whatsapp,\n  lead_id: g.lead_id,\n  conversa_atual: g.conversa\n}}];\n"
      },
