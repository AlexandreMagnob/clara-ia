        "jsCode": "const b = $json.body || {};\nconst nome = String(b['Nome'] || '').trim() || 'Lead Representantes';\nconst email = String(b['E-mail'] || b['Email'] || '').trim();\nconst telefone = String(b['WhatsApp'] || b['Telefone'] || '').trim();\nconst cf = [];\nif (email) cf.push({ field_code: 'EMAIL', values: [{ value: email }] });\nif (telefone) cf.push({ field_code: 'PHONE', values: [{ value: telefone }] });\nconst contact = { name: nome, responsible_user_id: 12387959 };\nif (cf.length) contact.custom_fields_values = cf;\nreturn [{ json: { nome: nome, contact_body: [contact] } }];"
