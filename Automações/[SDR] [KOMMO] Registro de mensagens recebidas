    {
      "parameters": {
        "jsCode": "// n8n Function Node — Normalizar nono dígito (Brasil) a partir de item.json.numero\nreturn $input.all().map((item) => {\n  const raw = $input.first().json?._embedded.contacts[0].custom_fields_values[0].values[0].value ?? '';\n  // mantém apenas dígitos\n  let numero = String(raw).replace(/\\D+/g, '');\n\n  const out = {\n    raw,\n    numero_original: numero,\n    numero_normalizado: null,\n    ddd: null,\n    teve_mudanca: false,\n    motivo: null,\n    valido_brasil: false,\n  };\n\n  // Se não começar com 55, não tenta \"adivinhar\" país\n  if (!numero.startsWith('55')) {\n    out.motivo = 'nao_comeca_com_55';\n    out.numero_normalizado = numero;\n    return { json: out };\n  }\n\n  // Precisa ter pelo menos 55 + DDD (4 dígitos)\n  if (numero.length < 4) {\n    out.motivo = 'curto_demais_para_ddd';\n    out.numero_normalizado = numero;\n    return { json: out };\n  }\n\n  const dddStr = numero.slice(2, 4);\n  const ddd = parseInt(dddStr, 10);\n  out.ddd = Number.isNaN(ddd) ? null : ddd;\n\n  if (Number.isNaN(ddd) || ddd < 11 || ddd > 99) {\n    out.motivo = 'ddd_invalido';\n    out.numero_normalizado = numero;\n    return { json: out };\n  }\n\n  // Parte local depois de 55 + DDD\n  const idxLocal = 4;\n  const local = numero.slice(idxLocal);\n\n  // Celular esperado: 9 dígitos locais (com nono dígito '9')\n  // Sem nono dígito: 8 dígitos locais (insere '9' no início)\n  if (local.length === 8) {\n    // adiciona nono dígito\n    numero = numero.slice(0, idxLocal) + '9' + numero.slice(idxLocal);\n    out.teve_mudanca = true;\n    out.motivo = 'adicionou_nono_digito';\n  } else if (local.length === 9) {\n    // já tem 9 dígitos locais; NÃO força que o primeiro seja 9 (pra não quebrar casos estranhos)\n    out.motivo = 'ja_tem_9_digitos_locais';\n  } else {\n    // tamanhos inesperados: não mexe\n    out.motivo = `tamanho_local_inesperado_${local.length}`;\n  }\n\n  out.numero_normalizado = numero;\n  out.valido_brasil = true;\n\n  return { json: out };\n});\n"
      },
