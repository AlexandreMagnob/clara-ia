      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normaliza telefone BR -> 55 + DDD + 9 + numero e filtra quem nao tem \"ID do Portal\"\nfunction normalizePhone(raw) {\n  let d = String(raw == null ? '' : raw).replace(/\\D/g, '');\n  d = d.replace(/^0+/, '');\n  if (d.startsWith('55') && d.length > 11) d = d.slice(2); // tira DDI se ja veio\n  if (d.length < 10) return '';                            // invalido\n  const ddd = d.slice(0, 2);\n  let rest = d.slice(2);\n  if (rest.length === 8) rest = '9' + rest;                // garante o 9 do celular\n  return '55' + ddd + rest;\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const idPortal = j['ID do Portal'];\n  if (idPortal === undefined || idPortal === null || String(idPortal).trim() === '') continue; // sem ID do Portal -> nao envia\n  const telefone = normalizePhone(j.Telefone);\n  if (!telefone) continue;\n  const primeiro_nome = String(j.Nome || '').trim().split(/\\s+/)[0] || '';\n  out.push({ json: { ...j, telefone, primeiro_nome } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
