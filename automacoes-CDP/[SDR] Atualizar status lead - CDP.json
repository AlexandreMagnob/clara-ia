    {
      "parameters": {
        "jsCode": "const users = ($input.first().json.data) || [];\nconst b = ($('Webhook').first().json.body) || {};\nconst ms = (b.prospection && b.prospection.meetings) || [];\nconst email = (ms[0] && ms[0].ownerEmail) || '';\nconst norm = s => (s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase().trim();\nconst alvo = norm(email);\nconst user = alvo ? users.find(u => norm(u.email) === alvo) : null;\nreturn [{ json: { owner_id: user ? user.id : null, closer_name: user ? user.name : null, closer_email: email || null } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -60
      ],
      "id": "closer-por-email",
      "name": "Closer por email"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DO $do$\nDECLARE v_deal uuid;\nBEGIN\n  SELECT cd.id INTO v_deal\n  FROM commercial_deals cd\n  JOIN persons pe ON pe.id = cd.person_id\n  WHERE (pe.telephone = '{{ $('Webhook').item.json.body.prospection.lead.phones[0].phone.replace(/\\D/g,'') }}'\n         OR cd.meetime_lead_id = '{{ $('Webhook').item.json.body.prospection.lead.id }}')\n    AND cd.discarded_at IS NULL\n  ORDER BY cd.created_at DESC\n  LIMIT 1;\n\n  IF v_deal IS NULL THEN\n    RAISE EXCEPTION 'Lead nao cadastrado no CDP (Meetime LOST) - tel: %, meetime_id: %',\n      '{{ $('Webhook').item.json.body.prospection.lead.phones[0].phone.replace(/\\D/g,'') }}',\n      '{{ $('Webhook').item.json.body.prospection.lead.id }}';\n  END IF;\n\n  UPDATE commercial_deals SET\n    status = 'lost',\n    lost_at = COALESCE(NULLIF('{{ $('Webhook').item.json.body.prospection.endDate }}', '')::timestamptz, now()),\n    loss_reason = NULLIF($lr${{ $('Webhook').item.json.body.prospection.lostReason.name }}$lr$, ''),\n    meetime_lead_id = COALESCE(meetime_lead_id, NULLIF('{{ $('Webhook').item.json.body.prospection.lead.id }}', '')),\n    updated_at = now()\n  WHERE id = v_deal;\nEND\n$do$;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        -320
      ],
