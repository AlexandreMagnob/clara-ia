    {
      "parameters": {
        "jsCode": "// Próximo dia útil a partir de hoje (Brasília). Sex->Seg; pula sáb/dom.\nconst OFF = 3 * 60 * 60 * 1000; // BRT = UTC-3\nconst nowBRT = new Date(Date.now() - OFF);\n\nlet d = new Date(nowBRT);\nd.setUTCDate(d.getUTCDate() + 1);\nwhile (d.getUTCDay() === 0 || d.getUTCDay() === 6) {\n  d.setUTCDate(d.getUTCDate() + 1);\n}\n\nconst dd = String(d.getUTCDate()).padStart(2, '0');\nconst mm = String(d.getUTCMonth() + 1).padStart(2, '0');\nconst yyyy = d.getUTCFullYear();\nconst data_alvo = `${yyyy}-${mm}-${dd}`;\nconst data_e_hora = `${data_alvo}T09:00:00-03:00`; // tem 'T' p/ o split interno da consulta_agenda\n\n// label: \"amanhã\" se for +1 civil, senão o nome do dia\nconst amanha = new Date(nowBRT); amanha.setUTCDate(amanha.getUTCDate() + 1);\nconst ehAmanha = (d.getUTCDate() === amanha.getUTCDate() && d.getUTCMonth() === amanha.getUTCMonth());\nconst dias = ['domingo','segunda','terça','quarta','quinta','sexta','sábado'];\nconst dia_label = ehAmanha ? 'amanhã' : dias[d.getUTCDay()];\n\nreturn [{ json: {\n  data_alvo,\n  data_e_hora,\n  dia_label,\n  whatsapp: $('Get a row').first().json.whatsapp\n}}];\n"
      },
