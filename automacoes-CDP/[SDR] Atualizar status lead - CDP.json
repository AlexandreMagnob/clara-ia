    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DO $do$\nDECLARE v_deal uuid;\nBEGIN\n  SELECT cd.id INTO v_deal\n  FROM commercial_deals cd\n  JOIN persons pe ON pe.id = cd.person_id\n  WHERE (pe.telephone = '{{ $('Webhook').item.json.body.prospection.lead.phones[0].phone.replace(/\\D/g,'') }}'\n         OR cd.meetime_lead_id = '{{ $('Webhook').item.json.body.prospection.lead.id }}')\n    AND cd.discarded_at IS NULL\n  ORDER BY cd.created_at DESC\n  LIMIT 1;\n\n  IF v_deal IS NULL THEN\n    RAISE EXCEPTION 'Lead nao cadastrado no CDP (Meetime WON) - tel: %, meetime_id: %',\n      '{{ $('Webhook').item.json.body.prospection.lead.phones[0].phone.replace(/\\D/g,'') }}',\n      '{{ $('Webhook').item.json.body.prospection.lead.id }}';\n  END IF;\n\n  UPDATE commercial_deals SET\n    stage = 'oportunidade',\n    status = 'open',\n    scheduled_meeting_at = NULLIF('{{ $('Webhook').item.json.body.prospection.meetings?.[0]?.startDate || '' }}', '')::timestamptz,\n    closer_user_id = COALESCE(\n      (SELECT id FROM users WHERE lower(email) = lower('{{ $('Webhook').item.json.body.prospection.meetings?.[0]?.ownerEmail || '' }}')),\n      closer_user_id),\n    meetime_lead_id = COALESCE(meetime_lead_id, NULLIF('{{ $('Webhook').item.json.body.prospection.lead.id }}', '')),\n    custom_properties = COALESCE(custom_properties, '{}'::jsonb) || jsonb_build_object(\n      'oportunidade_at', COALESCE(NULLIF('{{ $('Webhook').item.json.body.prospection.endDate }}', ''), now()::text),\n      'closer', NULLIF($cn${{ $('Closer por email').item.json.closer_name || '' }}$cn$, ''),\n      'closer_email', NULLIF('{{ $('Webhook').item.json.body.prospection.meetings?.[0]?.ownerEmail || '' }}', '')\n    ),\n    updated_at = now()\n  WHERE id = v_deal;\nEND\n$do$;",
