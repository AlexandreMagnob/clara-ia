    {
      "parameters": {
        "jsCode": "function normalizeBR(raw){ if(!raw) return null; let d=String(raw).replace(/\\D/g,'');\n  if(d.length===13&&d.startsWith('55')) return d;\n  if(d.length===12&&d.startsWith('55')) return d.slice(0,4)+'9'+d.slice(4);\n  if(d.startsWith('55')&&d.length>11) d=d.slice(2);\n  if(d.length===11) return '55'+d;\n  if(d.length===10) return '55'+d.slice(0,2)+'9'+d.slice(2);\n  return d.startsWith('55')?d:'55'+d; }\nconst c = $('Busca contato').first().json;\nconst cf = c.custom_fields_values || [];\nconst phoneField = cf.find(f => f.field_code === 'PHONE');\nconst rawPhone = (phoneField && phoneField.values && phoneField.values[0] && phoneField.values[0].value) || null;\nreturn [{ json: {\n  whatsapp: normalizeBR(rawPhone),\n  whatsapp_raw: rawPhone,\n  kommo_id_novo: $('Get list of leads').first().json.id\n} }];"
      },
