    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  pe.name                              AS \"Nome\",\n  pe.telephone                         AS \"Telefone\",\n  pe.email                             AS \"Email\",\n  d.custom_properties->>'empresa'      AS \"Empresa\",\n  d.segment                            AS \"Segmento\",\n  d.tier                               AS \"Tier\",\n  d.status                             AS \"Status\",\n  d.stage                              AS \"Etapa\",\n  COALESCE(u.name, d.custom_properties->>'closer') AS \"Closer\",\n  d.created_at                         AS \"Data criação\",\n  d.scheduled_meeting_at               AS \"Data reunião\",\n  d.custom_properties->>'oportunidade_at' AS \"Data oportunidade\",\n  d.won_at                             AS \"Data ganho\",\n  d.lost_at                            AS \"Data perda\",\n  d.loss_reason                        AS \"Motivo perda\",\n  d.raw_payload->>'utm_source'         AS \"Origem\",\n  d.raw_payload->>'utm_medium'         AS \"utm_medium\",\n  d.raw_payload->>'utm_campaign'       AS \"utm_campaign\",\n  d.raw_payload->>'utm_content'        AS \"utm_content\",\n  d.raw_payload->>'utm_ad'             AS \"utm_term\",\n  d.raw_payload->>'utm_platform'       AS \"utm_placement\",\n  d.deal_value                         AS \"deal_value\"\nFROM commercial_deals d\nJOIN persons pe ON pe.id = d.person_id\nLEFT JOIN users u ON u.id = d.closer_user_id\nWHERE (pe.telephone = '{{ $('Webhook').item.json.body.prospection.lead.phones[0].phone.replace(/\\D/g,'') }}'\n       OR d.meetime_lead_id = '{{ $('Webhook').item.json.body.prospection.lead.id }}')\n  AND d.discarded_at IS NULL\nORDER BY d.updated_at DESC\nLIMIT 1;",
